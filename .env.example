# Local/demo environment. Copy to .env (`make up` does this when .env is missing).
# .env is gitignored. Values here are local placeholders, not production secrets.
# Override them before pointing this stack at anything but a laptop or demo VM.
#
# Contract: docs/architecture/02-containers-deployment.md

# --- Postgres (pgvector/pgvector:pg16) ---
POSTGRES_USER=triage
POSTGRES_PASSWORD=local-dev-postgres-password
POSTGRES_DB=triage
POSTGRES_PORT=5432

# Connection string used by api and worker. Contains the database password.
DATABASE_URL=postgresql://triage:local-dev-postgres-password@postgres:5432/triage

# Restricted app role. Not created by this scaffold; T03 migrations introduce it
# and revoke UPDATE/DELETE on audit_events. Documented so the secret has a name.
APP_DB_USER=triage_app
APP_DB_PASSWORD=local-dev-app-password

# --- API (:8080) ---
API_PORT=8080

# analystAuth: HMAC secret for demo JWTs (static dev IdP, see openapi analystAuth).
JWT_SECRET=local-dev-jwt-secret

# Static analyst bearer token referenced by docs/testing.md ($DEV_JWT).
# T06 mints a real demo JWT; this placeholder is not a signed token.
DEV_JWT=local-dev-analyst-jwt

# splunkToken: query secret on POST /v1/ingest/splunk/{instance}?token=
SPLUNK_WEBHOOK_TOKEN=local-dev-splunk-webhook-token

# botApiKey: value of the X-GrokBot-Key header. Bound to one analyst in T16.
GROK_BOT_API_KEY=local-dev-grok-bot-key
GROK_BOT_ANALYST=analyst-demo
# One bot key per on-shift analyst (the worker round-robins cases to Priya and Omar). Overrides the single key above.
GROK_BOT_KEYS='{"local-dev-bot-priya":{"bot_id":"grokbot-priya","on_behalf_of":"analyst-priya"},"local-dev-bot-omar":{"bot_id":"grokbot-omar","on_behalf_of":"analyst-omar"}}'

# --- Worker (LLM / embeddings). CI must not call a real model. Leave keys empty. ---
LLM_API_KEY=
LLM_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=

# --- Console ---
CONSOLE_PORT=5173

# --- Optional secrets, not started by `make up` ---
# cloudflared tunnel so a Grok Bot routine can reach the API (deployment diagram).
CLOUDFLARE_TUNNEL_TOKEN=

# Splunk REST read-only drill-down (stretch; system context).
SPLUNK_HOST=
SPLUNK_REST_TOKEN=

# Action executor stays dry-run until connectors are real (config, not a secret).
EXECUTOR_DRY_RUN=true

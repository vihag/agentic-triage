{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidencePack",
  "description": "Everything an analyst (or their Grok Bot) needs to judge a case, with provenance for every item. Built by the Triage Agent on escalation, appended to by Grok Bot enrichments. Owned by Triage-Agent/ML engineer.",
  "type": "object",
  "required": ["evidence_pack_id", "case_id", "alert_id", "version", "generated_at", "generated_by", "summary", "items"],
  "additionalProperties": false,
  "properties": {
    "evidence_pack_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "case_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "alert_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "version": { "type": "integer", "minimum": 1, "description": "Bumped on every append." },
    "generated_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "generated_by": { "$ref": "common.schema.json#/$defs/Principal" },
    "summary": { "type": "string", "minLength": 1 },
    "entities": { "$ref": "common.schema.json#/$defs/Entities" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "kind", "title", "source", "collected_at", "added_by"],
        "additionalProperties": false,
        "properties": {
          "evidence_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["raw_event", "rule_match", "similar_incident", "enrichment", "threat_intel", "asset_context", "identity_context", "splunk_search", "llm_reasoning"] },
          "title": { "type": "string" },
          "source": { "type": "string", "description": "System or query the item came from." },
          "collected_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
          "added_by": { "$ref": "common.schema.json#/$defs/Principal" },
          "data": { "type": "object" },
          "link": { "type": "string" }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ts", "description"],
        "additionalProperties": false,
        "properties": {
          "ts": { "$ref": "common.schema.json#/$defs/Timestamp" },
          "description": { "type": "string" },
          "evidence_ref": { "type": "string" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alert",
  "description": "Normalised, immutable alert produced by the Ingest component from a SIEM webhook. Owned by Backend engineer.",
  "type": "object",
  "required": ["alert_id", "source", "received_at", "splunk_severity", "title", "entities", "dedup_key", "raw"],
  "additionalProperties": false,
  "properties": {
    "alert_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "source": {
      "type": "object",
      "required": ["system", "sid", "search_name"],
      "additionalProperties": false,
      "properties": {
        "system": { "type": "string", "enum": ["splunk", "simulator"] },
        "instance": { "type": "string", "description": "Logical id of the SIEM instance (from the ingest URL)." },
        "sid": { "type": "string" },
        "search_name": { "type": "string" },
        "app": { "type": "string" },
        "owner": { "type": "string" },
        "results_link": { "type": "string" }
      }
    },
    "received_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "event_time": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "splunk_severity": { "$ref": "common.schema.json#/$defs/Severity" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "entities": { "$ref": "common.schema.json#/$defs/Entities" },
    "mitre_techniques": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" } },
    "dedup_key": { "type": "string", "description": "sha256(search_name + sorted entity values + 15-min bucket). Repeat alerts attach to the open case." },
    "raw": { "type": "object", "description": "Original webhook body, verbatim." }
  }
}

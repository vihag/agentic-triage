{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case",
  "description": "Unit of work for SOC analysts. One case per alert (repeat alerts with the same dedup_key attach to the open case). Every alert gets a case, including auto-closed ones, so downgrades are auditable and re-openable. Owned by Backend engineer; persisted by Data/DB engineer.",
  "type": "object",
  "required": ["case_id", "alert_ids", "decision_id", "title", "severity", "original_severity", "direction", "status", "queue", "priority", "candidate_labels", "created_at", "updated_at", "version"],
  "additionalProperties": false,
  "properties": {
    "case_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "alert_ids": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/Uuid" } },
    "decision_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "title": { "type": "string" },
    "severity": { "$ref": "common.schema.json#/$defs/Severity" },
    "original_severity": { "$ref": "common.schema.json#/$defs/Severity" },
    "direction": { "type": "string", "enum": ["escalated", "downgraded", "unchanged"] },
    "status": {
      "type": "string",
      "enum": ["queued", "claimed", "in_progress", "awaiting_approval", "resolved", "false_positive", "auto_closed", "closed"]
    },
    "queue": { "type": "string", "description": "e.g. soc-high, soc-downgrade-review, none" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "assignee": { "type": ["string", "null"], "description": "Analyst id the case is assigned to (routing). A Grok Bot may claim only cases assigned to its analyst." },
    "claimed_by": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Principal" }, { "type": "null" }] },
    "lease_expires_at": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
    "candidate_labels": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/CandidateLabel" } },
    "evidence_pack_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Uuid" }, { "type": "null" }] },
    "next_steps_pack_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Uuid" }, { "type": "null" }] },
    "pending_action_count": { "type": "integer", "minimum": 0 },
    "resolution": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "resolved_by", "resolved_at"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string", "enum": ["true_positive_contained", "true_positive_no_action", "false_positive", "benign_true_positive", "duplicate", "auto_closed_downgrade"] },
            "note": { "type": "string" },
            "resolved_by": { "$ref": "common.schema.json#/$defs/Principal" },
            "resolved_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
          }
        }
      ]
    },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "version": { "type": "integer", "minimum": 1, "description": "Optimistic concurrency token; send as If-Match on mutations." }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NextStepsPack",
  "description": "Suggested next steps for a case: ordered playbook steps, proposed actions (each needing analyst approval) and draft communications. Owned by Triage-Agent/ML engineer.",
  "type": "object",
  "required": ["next_steps_pack_id", "case_id", "version", "generated_at", "generated_by", "steps"],
  "additionalProperties": false,
  "properties": {
    "next_steps_pack_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "case_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "generated_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "generated_by": { "$ref": "common.schema.json#/$defs/Principal" },
    "playbook_id": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "order", "phase", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "step_id": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "phase": { "type": "string", "enum": ["investigate", "contain", "eradicate", "recover", "notify", "document"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "done": { "type": "boolean", "default": false },
          "proposed_action": { "$ref": "action.schema.json" }
        }
      }
    },
    "draft_responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel", "audience", "body"],
        "additionalProperties": false,
        "properties": {
          "channel": { "type": "string", "enum": ["email", "slack", "ticket"] },
          "audience": { "type": "string" },
          "subject": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    }
  }
}
